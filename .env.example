# VulnFlanker platform configuration template.
#
# Copy this file to `.env` before starting the platform. Values marked
# "change before shared use" should be changed for any machine reachable by
# other users, networks, or Agents.
#
# Host Agent runtime variables are intentionally not listed here. The platform
# console generates Agent install scripts with Agent-side settings such as
# enrollment token, asset metadata, state/log paths, and polling intervals.

# -----------------------------------------------------------------------------
# Application identity
# -----------------------------------------------------------------------------
# Usually safe to keep as-is. `VULNFLANKER_SYSTEM_TIMEZONE` controls dashboard
# date boundaries and scheduled-calendar interpretation.
VULNFLANKER_APP_NAME=VulnFlanker
VULNFLANKER_APP_ENV=development
VULNFLANKER_LOG_LEVEL=INFO
VULNFLANKER_SYSTEM_TIMEZONE=Asia/Shanghai

# -----------------------------------------------------------------------------
# Platform routes and public network boundary
# -----------------------------------------------------------------------------
# Local-first defaults bind API and Agent ingress to localhost. Set a bind value
# to `0.0.0.0` only when that service must be reachable from another host, then
# protect it with a firewall or reverse proxy.
VULNFLANKER_API_PREFIX=/api/v1
VULNFLANKER_AGENT_API_PREFIX=/agent/v1
VULNFLANKER_API_BIND=127.0.0.1
VULNFLANKER_API_PORT=8000
VULNFLANKER_AGENT_INGRESS_BIND=127.0.0.1
VULNFLANKER_AGENT_INGRESS_PORT=8001
VULNFLANKER_FRONTEND_BIND=0.0.0.0
VULNFLANKER_FRONTEND_PORT=8100

# Disabled by default. New deployments should use `/agent/v1`; enable this only
# temporarily while migrating an old Agent, then turn it off again.
VULNFLANKER_LEGACY_AGENT_API_ENABLED=false

# -----------------------------------------------------------------------------
# Database, Redis, and background workers
# -----------------------------------------------------------------------------
# Docker Compose injects internal database and Redis URLs into containers. For a
# Compose deployment, the main value to change before shared use is
# `VULNFLANKER_REDIS_PASSWORD`; keep the Redis URLs below in sync only if you run
# services outside the provided Compose file.
VULNFLANKER_DATABASE_URL=postgresql+psycopg://vulnflanker:vulnflanker@localhost:5432/vulnflanker
VULNFLANKER_REDIS_BIND=127.0.0.1
VULNFLANKER_REDIS_PORT=6379
VULNFLANKER_REDIS_PASSWORD=change-this-redis-password
VULNFLANKER_REDIS_URL=redis://:change-this-redis-password@localhost:6379/0
VULNFLANKER_CELERY_BROKER_URL=redis://:change-this-redis-password@localhost:6379/0
VULNFLANKER_CELERY_RESULT_BACKEND=redis://:change-this-redis-password@localhost:6379/1

# -----------------------------------------------------------------------------
# Authentication and browser sessions
# -----------------------------------------------------------------------------
# Leave `VULNFLANKER_BOOTSTRAP_ADMIN_PASSWORD` empty to use the first-run setup
# page. If you set it for automation, use a strong temporary password and rotate
# it after the first login.
VULNFLANKER_BOOTSTRAP_ADMIN_USERNAME=admin
VULNFLANKER_BOOTSTRAP_ADMIN_PASSWORD=
VULNFLANKER_BOOTSTRAP_ADMIN_DISPLAY_NAME=系统管理员
VULNFLANKER_SESSION_COOKIE_NAME=vulnflanker_session
VULNFLANKER_SESSION_TTL_SECONDS=86400

# Set true only when the browser accesses VulnFlanker over HTTPS.
VULNFLANKER_SESSION_COOKIE_SECURE=false

# Login CAPTCHA and progressive IP blocking. Set a long random shared secret on
# every non-development deployment; all Console API replicas must use the same
# value. Requests only trust forwarded IP headers when the direct peer belongs
# to one of the explicitly configured proxy networks.
VULNFLANKER_LOGIN_SECURITY_ENABLED=true
VULNFLANKER_LOGIN_SECURITY_SECRET=change-this-login-security-secret
VULNFLANKER_LOGIN_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128,172.16.0.0/12
VULNFLANKER_LOGIN_BAN_EXEMPT_CIDRS=
VULNFLANKER_LOGIN_IPV6_PREFIX_LENGTH=64
VULNFLANKER_LOGIN_CAPTCHA_LENGTH=5
VULNFLANKER_LOGIN_CAPTCHA_TTL_SECONDS=120
VULNFLANKER_LOGIN_CAPTCHA_ISSUE_LIMIT=20
VULNFLANKER_LOGIN_CAPTCHA_ISSUE_WINDOW_SECONDS=300
VULNFLANKER_LOGIN_CAPTCHA_FAILURE_LIMIT=20
VULNFLANKER_LOGIN_CAPTCHA_FAILURE_WINDOW_SECONDS=300
VULNFLANKER_LOGIN_FAILURE_THRESHOLD=5
VULNFLANKER_LOGIN_FAILURE_WINDOW_SECONDS=600
VULNFLANKER_LOGIN_PENALTY_DECAY_SECONDS=2592000

# -----------------------------------------------------------------------------
# Secrets and encryption keys
# -----------------------------------------------------------------------------
# Required only after saving encrypted values through the UI. Use long random
# values and keep backups; losing a key makes stored encrypted values
# unrecoverable.
VULNFLANKER_AI_KEY_ENCRYPTION_KEY=
VULNFLANKER_SECRET_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Vulnerability intelligence sources
# -----------------------------------------------------------------------------
# These defaults work for the built-in public feeds. Change source URLs only when
# a feed endpoint moves or you intentionally mirror/proxy it.
VULNFLANKER_CISA_KEV_FEED_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
VULNFLANKER_CISA_KEV_CATALOG_URL=https://www.cisa.gov/known-exploited-vulnerabilities-catalog
VULNFLANKER_CISA_KEV_CVE_RECORD_URL_TEMPLATE=https://cveawg.mitre.org/api/cve/{cve_id}
VULNFLANKER_CISA_KEV_CVE_RECORD_FETCH=true
VULNFLANKER_CISA_KEV_CVE_RECORD_WORKERS=8
VULNFLANKER_ALIYUN_AVD_HIGH_RISK_URL=https://avd.aliyun.com/high-risk/list

# Built-in WatchVuln collector. In Docker Compose, the collector path is injected
# automatically. Set command/path manually only for local or custom deployments.
VULNFLANKER_WATCHVULN_COLLECTOR_COMMAND=
VULNFLANKER_WATCHVULN_COLLECTOR_PATH=
VULNFLANKER_WATCHVULN_COLLECTOR_TIMEOUT_SECONDS=300
VULNFLANKER_WATCHVULN_SOURCES=avd,chaitin,oscs,ti,threatbook,seebug,struts2,kev,venustech
VULNFLANKER_WATCHVULN_PAGE_LIMIT=1
VULNFLANKER_WATCHVULN_VALUABLE_ONLY=true
VULNFLANKER_WATCHVULN_PROXY=
VULNFLANKER_WATCHVULN_SKIP_TLS_VERIFY=false

# -----------------------------------------------------------------------------
# Scheduled collection
# -----------------------------------------------------------------------------
# CISA KEV and WatchVuln monitoring are off by default. WatchVuln may call
# several upstream sources. `*_INTERVAL_SECONDS`
# controls collection cadence; `*_TICK_SECONDS` controls worker wake-up cadence;
# empty `*_LIMIT` means no explicit record limit.
VULNFLANKER_CISA_KEV_MONITOR_ENABLED=false
VULNFLANKER_CISA_KEV_MONITOR_INTERVAL_SECONDS=86400
VULNFLANKER_CISA_KEV_MONITOR_LIMIT=
VULNFLANKER_CISA_KEV_MONITOR_TICK_SECONDS=300
VULNFLANKER_WATCHVULN_MONITOR_ENABLED=false
VULNFLANKER_WATCHVULN_MONITOR_INTERVAL_SECONDS=1800
VULNFLANKER_WATCHVULN_MONITOR_LIMIT=
VULNFLANKER_WATCHVULN_MONITOR_TICK_SECONDS=60

# -----------------------------------------------------------------------------
# Inbound intelligence webhook
# -----------------------------------------------------------------------------
# Change the token before exposing the webhook to any network. Empty token means
# the webhook is not protected by this shared secret.
VULNFLANKER_INTEL_WEBHOOK_TOKEN=change-me
VULNFLANKER_INTEL_WEBHOOK_MAX_BODY_BYTES=1000000

# -----------------------------------------------------------------------------
# Risk and verification tuning
# -----------------------------------------------------------------------------
# Verification timeout values are active. Risk weights are advanced scoring
# defaults; leave them unchanged unless you are deliberately tuning or developing
# the scoring model.
VULNFLANKER_VERIFICATION_QUEUED_TIMEOUT_SECONDS=86400
VULNFLANKER_VERIFICATION_IN_PROGRESS_TIMEOUT_SECONDS=3600
VULNFLANKER_RISK_WEIGHT_SEVERITY=0.30
VULNFLANKER_RISK_WEIGHT_EXPLOITABILITY=0.18
VULNFLANKER_RISK_WEIGHT_EXPOSURE=0.15
VULNFLANKER_RISK_WEIGHT_BUSINESS_CRITICALITY=0.17
VULNFLANKER_RISK_WEIGHT_CONFIDENCE=0.08
VULNFLANKER_RISK_WEIGHT_VERIFICATION=0.07
VULNFLANKER_RISK_WEIGHT_ASSET_FRESHNESS=0.05

# -----------------------------------------------------------------------------
# Frontend build-time overrides
# -----------------------------------------------------------------------------
# Leave empty for the containerized frontend: Nginx serves the SPA and proxies
# same-origin `/api` and `/agent` requests. Set `VITE_AGENT_INGRESS_BASE_URL`
# only when generated Agent install scripts should default to a specific
# Agent-reachable URL, such as a reverse proxy or server LAN address.
VITE_API_BASE_URL=
VITE_AGENT_INGRESS_BASE_URL=
